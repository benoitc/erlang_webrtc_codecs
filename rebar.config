{erl_opts, [
    debug_info,
    warn_export_vars,
    warn_shadow_vars,
    warn_obsolete_guard,
    warn_unused_import,
    warnings_as_errors
]}.

{minimum_otp_vsn, "29"}.

%% erlang_webrtc gives the webrtc_media_codec behaviour the plugins
%% implement, and the peer connections the tests run them in.
{deps, [
    {webrtc, "~> 0.3.0"}
]}.

%% Codec NIFs, one per codec library found (c_src/CMakeLists.txt). Without
%% cmake only the codecs written in Erlang are there. Windows has no hook.
{pre_hooks, [
    {"(linux|darwin|solaris)", compile, "sh c_src/build_nif.sh"},
    {"(freebsd|netbsd|openbsd)", compile, "sh c_src/build_nif.sh"}
]}.
{post_hooks, [
    {"(linux|darwin|solaris)", clean, "sh c_src/build_nif.sh clean"},
    {"(freebsd|netbsd|openbsd)", clean, "sh c_src/build_nif.sh clean"}
]}.

{profiles, [
    {test, [
        {erl_opts, [debug_info, nowarn_export_all]}
    ]}
]}.

{project_plugins, [
    {rebar3_hex, "~> 7.0"},
    {rebar3_ex_doc, "~> 0.2"},
    %% Pinned: rebar3_lint changed how it resolves elvis.config within the
    %% 5.0 range, and plugins are not locked.
    {rebar3_lint, "5.0.4"},
    {erlfmt, "~> 1.7"}
]}.

{hex, [{doc, ex_doc}]}.

{ex_doc, [
    {source_url, <<"https://github.com/benoitc/erlang_webrtc_codecs">>},
    %% Release notes name functions that later changes removed.
    {skip_undefined_reference_warnings_on, [<<"CHANGELOG.md">>]},
    {extras, [
        <<"README.md">>,
        <<"CHANGELOG.md">>,
        <<"CONTRIBUTING.md">>,
        <<"SECURITY.md">>,
        <<"LICENSE">>,
        <<"docs/install.md">>,
        <<"docs/demo.md">>,
        <<"docs/raw-media.md">>,
        <<"docs/vp8-vp9.md">>,
        <<"docs/h264.md">>,
        <<"docs/av1.md">>,
        <<"docs/opus.md">>,
        <<"docs/g711.md">>,
        <<"docs/capture.md">>,
        <<"docs/playback.md">>,
        <<"docs/async.md">>,
        <<"docs/limits.md">>,
        <<"docs/architecture.md">>,
        <<"docs/module-map.md">>,
        <<"docs/glossary.md">>,
        <<"docs/behaviour-gaps.md">>
    ]},
    {groups_for_extras, [
        {<<"Guides">>, [
            <<"docs/install.md">>,
            <<"docs/demo.md">>,
            <<"docs/raw-media.md">>,
            <<"docs/vp8-vp9.md">>,
            <<"docs/h264.md">>,
            <<"docs/av1.md">>,
            <<"docs/opus.md">>,
            <<"docs/g711.md">>,
            <<"docs/capture.md">>,
            <<"docs/playback.md">>,
            <<"docs/async.md">>
        ]},
        {<<"How it works">>, [
            <<"docs/architecture.md">>,
            <<"docs/module-map.md">>,
            <<"docs/glossary.md">>,
            <<"docs/limits.md">>,
            <<"docs/behaviour-gaps.md">>
        ]},
        {<<"Contributing">>, [<<"CONTRIBUTING.md">>]}
    ]},
    {main, <<"readme">>},
    {groups_for_modules, [
        {<<"Public API">>, [webrtc_codecs]},
        {<<"Codec plugins">>, [
            webrtc_codecs_g711,
            webrtc_codecs_opus,
            webrtc_codecs_vpx,
            webrtc_codecs_h264,
            webrtc_codecs_av1
        ]},
        {<<"Devices and files">>, [
            webrtc_codecs_capture, webrtc_codecs_playback, webrtc_codecs_file
        ]},
        {<<"Test media">>, [webrtc_codecs_pattern]}
    ]}
]}.

{erlfmt, [
    write,
    {files, ["{src,test}/**/*.{hrl,erl,app.src}", "rebar.config"]}
]}.

%% Elvis lint rules live in elvis.config. rebar3 lint reads that file and
%% ignores an {elvis, ...} entry here whenever it exists.

{dialyzer, [
    {warnings, [error_handling, unknown, unmatched_returns]},
    {plt_apps, all_deps},
    {plt_extra_apps, [crypto, public_key, ssl]}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    deprecated_function_calls,
    deprecated_functions
]}.

{ct_opts, [{logdir, "_build/test/logs"}]}.

{cover_enabled, true}.
